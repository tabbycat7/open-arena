# =====================
# Open Arena .env example
# Copy this file to .env and fill in real values.
# =====================

# App
SECRET_KEY=change-this-to-a-random-secret

# Database
# Example:
# DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/open_arena?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/open_arena?charset=utf8mb4

# =====================
# Debate module (enhance/refute)
# =====================
ENHANCE_MODEL_API_URL=https://aihubmix.com/v1/chat/completions
ENHANCE_MODEL_API_KEY=
ENHANCE_MODEL_NAME=gemini-3-flash-preview

REFUTE_MODEL_API_URL=https://aihubmix.com/v1/chat/completions
REFUTE_MODEL_API_KEY=
# Comma-separated model names
REFUTE_MODEL_NAMES=gemini-3-flash-preview

# =====================
# Lesson arena module
# =====================
LESSON_MODEL_API_URL=https://aihubmix.com/v1/chat/completions
LESSON_MODEL_API_KEY=
# Comma-separated model names
LESSON_MODEL_NAMES=gemini-2.5-flash-preview,gpt-4o-mini,deepseek-v3,claude-3-5-haiku-20241022,qwen-turbo

# =====================
# Multi-agent teaching map
# =====================
TEACHING_MAP_LLM_BASE_URL=https://aihubmix.com/v1
TEACHING_MAP_LLM_API_KEY=
TEACHING_MAP_LLM_MODEL_NAME=deepseek-reasoner
# 显式控制多智能体每次请求的输出上限（可按模型能力调整）
TEACHING_MAP_LLM_MAX_TOKENS=12000
# LLM 请求超时（秒），避免某个生成阶段无限等待
TEACHING_MAP_LLM_TIMEOUT=180
TEACHING_MAP_SELECTABLE_MODEL_IDS=Pro/MiniMaxAI/MiniMax-M2.5,Pro/zai-org/GLM-5,Qwen/Qwen3.5-397B-A17B,Pro/deepseek-ai/DeepSeek-R1,Pro/moonshotai/Kimi-K2.5
# Optional: preferred model config list, easier to maintain than comma-separated ids
# TEACHING_MAP_MODEL_OPTIONS=[{"id":"Pro/zai-org/GLM-5","name":"GLM-5","icon":"images/model-icons/glm.svg"},{"id":"Pro/deepseek-ai/DeepSeek-R1","name":"DeepSeek-R1","icon":"images/model-icons/deepseek.svg"}]
TEACHING_MAP_DEFAULT_MODEL_ICON=images/model-icons/model-default.svg
TEACHING_MAP_MODEL_ICON_MAP={"Pro/MiniMaxAI/MiniMax-M2.5":"images/model-icons/minimax.svg","Pro/zai-org/GLM-5":"images/model-icons/glm.svg","Qwen/Qwen3.5-397B-A17B":"images/model-icons/qwen.svg","Pro/deepseek-ai/DeepSeek-R1":"images/model-icons/deepseek.svg","Pro/moonshotai/Kimi-K2.5":"images/model-icons/kimi.svg"}
TEACHING_MAP_DEFAULT_TEMPERATURE=0.7
# JSON object: model_id -> fixed temperature (0~2). These models will lock temperature on UI and backend.
TEACHING_MAP_FIXED_TEMPERATURE_MODELS={"claude-opus-4-6-think":1}
# 附件图片 OCR/解析（多模态模型）
# TEACHING_MAP_IMAGE_PARSER_MODEL_NAME=glm-4.5v
# HTML / SVG / Canvas 交互可视化生成模型；留空时回退到 TEACHING_MAP_GENERATOR_MODEL_NAME / TEACHING_MAP_LLM_MODEL_NAME
TEACHING_MAP_INTERACTIVE_VISUAL_MODEL_NAME=gpt-5.4-mini

# 教学地图节点配图生成（AiHubMix：auto | predictions | openai）
TEACHING_MAP_IMAGE_GEN_API_MODE=auto
TEACHING_MAP_IMAGE_GEN_MODEL=gpt-image-1
# TEACHING_MAP_IMAGE_GEN_MODEL_PATH=openai/gpt-image-1
TEACHING_MAP_IMAGE_GEN_SIZE=1024x1024
TEACHING_MAP_IMAGE_GEN_QUALITY=medium
# 单张请求超时（秒）；gemini-*-image-preview 建议 300+
TEACHING_MAP_IMAGE_GEN_TIMEOUT=300
# 并行线程数；Gemini 生图在代码中会自动 cap 为最多 2
TEACHING_MAP_IMAGE_GEN_MAX_WORKERS=5
# HTML / SVG / Canvas 交互可视化并发线程数
TEACHING_MAP_INTERACTIVE_VISUAL_MAX_WORKERS=5
# 可选：单独配图 API（留空则复用 TEACHING_MAP_LLM_BASE_URL / TEACHING_MAP_LLM_API_KEY）
# TEACHING_MAP_IMAGE_GEN_BASE_URL=https://aihubmix.com/v1
# TEACHING_MAP_IMAGE_GEN_API_KEY=

TEACHING_MAP_MAX_VALIDATION_RETRIES=3
TEACHING_MAP_MAIN_FULL_RECHECK_INTERVAL=2
TEACHING_MAP_MYSQL_DB=teaching_maps
