# ============================================================
# Open Arena —— 环境变量配置模板
# 将此文件复制为 .env 并填入实际值，.env 已被 .gitignore 忽略
# ============================================================

SECRET_KEY=change-this-to-a-random-secret

# ------------------------------------------------------------
# 数据库配置
# 格式: mysql+pymysql://<用户名>:<密码>@<主机>:<端口>/<库名>?charset=utf8mb4
# ------------------------------------------------------------
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/open_arena?charset=utf8mb4

# ------------------------------------------------------------
# 辩论场 —— "加持"模型（润色教师观点）
# ------------------------------------------------------------
ENHANCE_MODEL_API_URL=https://aihubmix.com/v1/chat/completions
ENHANCE_MODEL_API_KEY=
ENHANCE_MODEL_NAME=gemini-3.1-flash-lite-preview

# ------------------------------------------------------------
# 辩论场 —— "反驳"模型（逗号分隔，每次会话随机选一个）
# ------------------------------------------------------------
REFUTE_MODEL_API_URL=https://aihubmix.com/v1/chat/completions
REFUTE_MODEL_API_KEY=
REFUTE_MODEL_NAMES=gpt-5.4,claude-opus-4-6,gemini-3.1-pro-preview,qwen3.6-plus,DeepSeek-R1,glm-5,doubao-seed-2-0-pro,kimi-k2.5

# ------------------------------------------------------------
# 教案设计竞技场（逗号分隔，每次随机抽两个盲测）
# ------------------------------------------------------------
LESSON_MODEL_API_URL=https://aihubmix.com/v1/chat/completions
LESSON_MODEL_API_KEY=
LESSON_MODEL_NAMES=gpt-5.4,claude-opus-4-6,gemini-3.1-pro-preview,qwen3.6-plus,DeepSeek-R1,glm-5,doubao-seed-2-0-pro,kimi-k2.5

# ------------------------------------------------------------
# 多智能体教学地图 —— API 接入
# 以下注释了三种常用 API 提供商，取消注释并填入 key 即可切换
# ------------------------------------------------------------

# 方案 A：AiHubMix（默认）
TEACHING_MAP_LLM_BASE_URL=https://aihubmix.com/v1
TEACHING_MAP_LLM_API_KEY=

# 方案 B：DeepSeek 官方
# TEACHING_MAP_LLM_BASE_URL=https://api.deepseek.com
# TEACHING_MAP_LLM_API_KEY=

# 方案 C：OpenRouter
# TEACHING_MAP_LLM_BASE_URL=https://openrouter.ai/api/v1
# TEACHING_MAP_LLM_API_KEY=

# ------------------------------------------------------------
# 多智能体教学地图 —— 模型配置
# ------------------------------------------------------------
TEACHING_MAP_LLM_MAX_TOKENS=22000
TEACHING_MAP_VALIDATOR_MODEL_NAME=deepseek-v3.2-think
TEACHING_MAP_IMAGE_PARSER_MODEL_NAME=glm-4.5v
TEACHING_MAP_DEFAULT_TEMPERATURE=0.7
# JSON 对象：model_id -> 固定 temperature（0~2），这些模型在 UI 和后端均锁定温度
TEACHING_MAP_FIXED_TEMPERATURE_MODELS={"claude-opus-4-6-think":1}

# ------------------------------------------------------------
# 多智能体教学地图 —— 可选模型列表
# 支持两种格式（TEACHING_MAP_MODEL_OPTIONS 优先，设置后 SELECTABLE_MODEL_IDS 自动忽略）：
#   格式 1：TEACHING_MAP_SELECTABLE_MODEL_IDS — 逗号分隔 model id，图标自动匹配内置映射表
#   格式 2：TEACHING_MAP_MODEL_OPTIONS — JSON 数组，可自定义名称和图标，优先级更高
# ------------------------------------------------------------

# 格式 1：逗号分隔 id（格式 2 未设置时生效）
# TEACHING_MAP_SELECTABLE_MODEL_IDS=gpt-5.4,claude-opus-4-6,gemini-3.1-pro-preview,kimi-k2.5,DeepSeek-R1,glm-5

# 格式 2：JSON 数组（设置后覆盖格式 1）
TEACHING_MAP_MODEL_OPTIONS=[{"id":"gpt-5.4-high","name":"GPT-5.4 High","icon":"images/model-icons/gpt.svg"},{"id":"gpt-5.4","name":"GPT-5.4","icon":"images/model-icons/gpt.svg"},{"id":"gpt-5.4-low","name":"GPT-5.4 Low","icon":"images/model-icons/gpt.svg"},{"id":"claude-opus-4-6-think","name":"Claude Opus 4.6 Think","icon":"images/model-icons/claude.svg"},{"id":"claude-opus-4-6","name":"Claude Opus 4.6","icon":"images/model-icons/claude.svg"},{"id":"claude-sonnet-4-6-think","name":"Claude Sonnet 4.6 Think","icon":"images/model-icons/claude.svg"},{"id":"claude-sonnet-4-6","name":"Claude Sonnet 4.6","icon":"images/model-icons/claude.svg"},{"id":"gemini-3.1-pro-preview","name":"Gemini 3.1 Pro","icon":"images/model-icons/google.svg"},{"id":"gemini-3.1-flash-lite-preview","name":"Gemini 3.1 Flash","icon":"images/model-icons/google.svg"},{"id":"gemma-4-31b-it","name":"Gemma 4 31b","icon":"images/model-icons/google.svg"},{"id":"grok-4","name":"Grok 4","icon":"images/model-icons/grok.svg"},{"id":"kimi-k2.5","name":"Kimi K2.5","icon":"images/model-icons/kimi.svg"},{"id":"qwen3.6-plus","name":"Qwen3.6 Plus","icon":"images/model-icons/qwen.svg"},{"id":"doubao-seed-2-0-pro","name":"Doubao Seed 2.0 Pro","icon":"images/model-icons/doubao.svg"},{"id":"deepseek-v3.2-speciale","name":"DeepSeek V3.2 Speciale","icon":"images/model-icons/deepseek.svg"},{"id":"DeepSeek-R1","name":"DeepSeek R1","icon":"images/model-icons/deepseek.svg"},{"id":"glm-5","name":"GLM-5","icon":"images/model-icons/glm.svg"}]

TEACHING_MAP_DEFAULT_MODEL_ICON=images/model-icons/model-default.svg

# ------------------------------------------------------------
# 多智能体教学地图 —— 数据库
# ------------------------------------------------------------
TEACHING_MAP_MYSQL_DB=teaching_maps
