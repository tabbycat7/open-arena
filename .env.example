# =====================
# Open Arena .env example
# Copy this file to .env and fill in real values.
# =====================

# App
SECRET_KEY=change-this-to-a-random-secret

# Database
# Example:
# DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/open_arena?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/open_arena?charset=utf8mb4

# =====================
# Debate module (enhance/refute)
# =====================
ENHANCE_MODEL_API_URL=https://ssvip.dmxapi.com/v1/chat/completions
ENHANCE_MODEL_API_KEY=
ENHANCE_MODEL_NAME=gemini-3-flash-preview

REFUTE_MODEL_API_URL=https://ssvip.dmxapi.com/v1/chat/completions
REFUTE_MODEL_API_KEY=
# Comma-separated model names
REFUTE_MODEL_NAMES=gemini-3-flash-preview

# =====================
# Lesson arena module
# =====================
LESSON_MODEL_API_URL=https://ssvip.dmxapi.com/v1/chat/completions
LESSON_MODEL_API_KEY=
# Comma-separated model names
LESSON_MODEL_NAMES=gemini-2.5-flash-preview,gpt-4o-mini,deepseek-v3,claude-3-5-haiku-20241022,qwen-turbo

# =====================
# Multi-agent teaching map
# =====================
TEACHING_MAP_LLM_BASE_URL=https://api.deepseek.com
TEACHING_MAP_LLM_API_KEY=
TEACHING_MAP_LLM_MODEL_NAME=deepseek-reasoner
TEACHING_MAP_MAX_VALIDATION_RETRIES=3
TEACHING_MAP_MAIN_FULL_RECHECK_INTERVAL=2
TEACHING_MAP_MYSQL_DB=teaching_maps
